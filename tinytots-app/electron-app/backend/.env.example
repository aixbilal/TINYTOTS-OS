# TinyTots POS backend — environment contract (names + notes only, NO values).
# Copy to backend/.env and fill in locally. NEVER commit backend/.env or any
# real secret. In the packaged Electron app these are read from backend/.env
# by electron/main.js and passed to the spawned backend process.

# ---- Core ----
PORT=                       # local API port (default 3000)
SUPABASE_URL=               # https://<project>.supabase.co
SUPABASE_ANON_KEY=          # anon key (not used for privileged reads here)
SUPABASE_SERVICE_ROLE_KEY=  # SECRET — full DB access; server-side only
POS_API_SECRET=             # SECRET — shared secret for mutating /api routes; must match VITE_POS_API_SECRET

# ---- Daily sales report: SMTP mailbox (all REQUIRED) ----
SMTP_HOST=                  # e.g. smtp.hostinger.com
SMTP_PORT=                  # 465 = implicit TLS (secure); 587/25 = STARTTLS. secure mode is derived from this.
SMTP_USER=                  # the mailbox login, e.g. support@tinytotsofficial.com
SMTP_PASS=                  # SECRET — mailbox / app password. Never printed, logged, or committed.

# ---- Daily sales report: sender + fallback (all OPTIONAL) ----
REPORT_FROM_EMAIL=          # visible From address. Default: SMTP_USER
REPORT_FROM_NAME=           # visible From name.    Default: "TinyTots"
REPORT_FALLBACK_EMAIL=      # sole recipient ONLY when 0 active rows exist in daily_report_recipients.
                            # Default: OWNER_EMAIL (below), kept for backward compatibility.
OWNER_EMAIL=                # legacy fallback recipient. Superseded by REPORT_FALLBACK_EMAIL.
                            # Should NOT be a personal inbox — set it (or REPORT_FALLBACK_EMAIL)
                            # to a monitored business/team address.

# ---- WhatsApp notifications (standalone backend only) ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=

# ---- AI (product finder) ----
GROQ_API_KEY=               # SECRET
GROQ_PRODUCT_FINDER_MODEL=  # optional model override
