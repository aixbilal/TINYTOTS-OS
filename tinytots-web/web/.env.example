# TinyTots web — environment contract (names + classification only, NO values).
# Local dev: copy to .env.local and fill in. Cloudflare: see classification below.
#
# Classes:
#   PUBLIC_BUILD           - inlined into the browser bundle at build; not secret.
#   SERVER_BUILD_REQUIRED  - must be present during `next build` / `build:cf`
#                            (SSG / generateStaticParams reads it); not secret.
#   SERVER_RUNTIME_SECRET  - secret; supply ONLY as a Cloudflare encrypted Secret
#                            (`wrangler secret put` / dashboard). NEVER put in
#                            wrangler.jsonc `vars`, and keep it OUT of the env
#                            used for the Cloudflare production build (OpenNext
#                            bakes .env* values as plaintext into next-env.mjs).
#   SERVER_RUNTIME_CONFIG  - non-secret server config; Cloudflare `vars` is fine.
#   OPTIONAL_RUNTIME       - feature degrades gracefully if unset.
#   LOCAL_ONLY             - test/scripts only; never deployed.

# ---- PUBLIC_BUILD (safe in browser) ----
NEXT_PUBLIC_SUPABASE_URL=            # also SERVER_BUILD_REQUIRED (SSG data fetches)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # also SERVER_BUILD_REQUIRED (RLS-scoped anon reads at build)
NEXT_PUBLIC_SITE_URL=                # canonical origin, e.g. https://tinytotsofficial.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=       # OPTIONAL_RUNTIME - GA4 id; analytics off if unset
NEXT_PUBLIC_META_PIXEL_ID=           # OPTIONAL_RUNTIME - Meta Pixel id; off if unset
NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # OPTIONAL_RUNTIME - Cloudflare Turnstile PUBLIC site key (login/signup/forgot-password); CAPTCHA UI off if unset. The Turnstile SECRET key is never app config — it's entered directly in the Supabase Dashboard's own CAPTCHA provider settings.

# ---- SERVER_BUILD_REQUIRED (non-secret build inputs) ----
# (covered by the two NEXT_PUBLIC_SUPABASE_* keys above - listed once)

# ---- SERVER_RUNTIME_SECRET (Cloudflare encrypted Secrets only) ----
SUPABASE_SERVICE_ROLE_KEY=           # full-access Supabase key - server only, never NEXT_PUBLIC
GROQ_API_KEY=                        # primary AI (product finder / descriptions)
GEMINI_PRODUCT_FINDER_API_KEY=       # AI fallback - product finder
GEMINI_PRODUCT_DESCRIPTION_API_KEY=  # AI fallback - admin description generator
UPSTASH_REDIS_REST_TOKEN=            # rate-limit + AI budget + intent cache
WHATSAPP_CLOUD_API_TOKEN=            # WhatsApp Cloud API bearer token
WHATSAPP_NOTIFY_SECRET=              # shared secret protecting POST /api/v1/whatsapp-notify
WHATSAPP_WEBHOOK_VERIFY_TOKEN=       # Meta webhook verification challenge token
META_APP_SECRET=                     # verifies X-Hub-Signature-256 on the WhatsApp webhook
META_AGENT_SECRET=                   # bearer secret for /api/v1/meta-agent/* endpoints

# ---- SERVER_RUNTIME_CONFIG (non-secret; Cloudflare `vars` OK) ----
UPSTASH_REDIS_REST_URL=              # Upstash REST endpoint (pairs with the token above)
WHATSAPP_PHONE_NUMBER_ID=           # WhatsApp sender phone-number id (not secret)
GEMINI_MODEL=                        # optional override, defaults in lib/ai/gemini.ts
GROQ_MODEL=                          # optional override, defaults in lib/ai/groq.ts
# NEXTJS_ENV=production              # (.dev.vars only) selects the next-env.mjs bucket on workerd

# ---- LOCAL_ONLY (never deployed) ----
AUTH_TEST_BASE=
AUTH_TEST_ADMIN_EMAIL=
AUTH_TEST_ADMIN_PASSWORD=
AUTH_TEST_ADMIN_PASSWORD_B=
AUTH_TEST_CUSTOMER_EMAIL=
AUTH_TEST_CUSTOMER_PASSWORD=
AUTH_TEST_CUSTOMER_PASSWORD_NEW=
