{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinytots",
  "main": ".open-next/worker.js",
  // 2026-08-04+ turns on modern Node.js compatibility behaviour by default
  // (per current Workers docs); nodejs_compat + global_fetch_strictly_public
  // are the two flags @opennextjs/cloudflare requires.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Dashboard-defined runtime Variables/Secrets are otherwise dropped by
  // `wrangler deploy` because this file has no `vars` block (none belong in
  // Git — see K.2-B). keep_vars stops deploys from clearing them.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tinytots"
    }
  ],
  // App uses a custom Supabase image loader and never hits /_next/image in
  // production, so this binding is unused today — kept per OpenNext guidance
  // so image optimization has a backend if the loader is ever removed.
  "images": {
    "binding": "IMAGES"
  },
  // Dashboard-enabled Observability (Logs/Traces) is otherwise reset by
  // `wrangler deploy` for the same reason keep_vars exists — this file is
  // deploy's source of truth and had no observability block. Mirrors the
  // config Cloudflare's own dashboard warning recommends.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
